					]
				},
				{
					"callFunction": "setText",
					"sid": 447342880045922,
					"parameters": [
						"\"21\"",
						"\"NON-PROFIT ACCOUNT?\"",
						"1"
					]
				},
				{
					"callFunction": "setText",
					"sid": 338281084862661,
					"parameters": [
						"\"33\"",
						"\"                                                                                                  refers to the accounting system used by organizations that operate to provide services and benefits to the public or their members rather than to earn profit. These organizations include charities, clubs, religious institutions, educational societies, and non-governmental organizations (NGOs).\n\nThe main purpose of this accounting system is to record financial transactions accurately, ensure transparency and accountability, and show how funds such as donations, grants, sponsorships, and membership fees are utilized. Unlike business organizations, non-profit organizations do not distribute profits to owners or shareholders. Instead, any surplus earned is reinvested into the organization to support its activities and objectives.\n\nNon-profit organizations usually prepare several financial statements, including the Receipts and Payments Account, Income and Expenditure Account, and Balance Sheet or Statement of Financial Position. The Receipts and Payments Account records all cash received and paid during a specific period, while the Income and Expenditure Account determines whether the organization has a surplus or deficit. The Balance Sheet shows the organization’s assets, liabilities, and accumulated funds.\n\nProper accounting practices are important for non-profit organizations to maintain public trust, ensure responsible management of funds, and support effective decision-making for future programs and activities.\"",
						"10"
					]
				},
				{
					"id": "wait",
					"objectClass": "System",
					"sid": 112377588182510,
					"parameters": {
						"seconds": "1.0",
						"use-timescale": true
					}
				},
				{
					"callFunction": "setText",
					"sid": 595116356045393,
					"parameters": [
						"\"3\"",
						"\"MUHAMMAD ZAKI BIN AB. MULUK\nZARIYAH BINTI ABDULLAH\"",
						"1"
					]
				}
